---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import heroImage from '../assets/hero-img-slider.svg';

// ✅ Importaciones de imágenes de proyectos (sin .src)
import moodleImage from '../assets/projects/moodle-proyecto.webp';
import efficaceImage from '../assets/projects/efficace-proyecto.webp';
import streamingImage from '../assets/projects/streaming-proyecto.webp';
import wordpressImage from '../assets/projects/wordpress-proyecto.webp';
import cloudLabImage from '../assets/projects/cloud-lab-proyecto.webp';
import impactImage from '../assets/projects/impact-proyecto.webp';

---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
  </head>

  <body class="bg-primary-dark text-white font-sans">
    <Header />

    <main class="max-w-[1200px] mx-auto px-8">

      <!-- Hero Section -->
      <section class="hero my-20">
        <div class="grid grid-cols-1 md:grid-cols-[2fr_3fr] gap-8 items-center">

          <!-- Left Column - Texto -->
          <div class="hero__left text-center md:text-left">
            <p class="text-accent-yellow text-sm md:text-base font-semibold uppercase tracking-[0.18em] mb-4">
              Procesos · Tecnología · Datos
            </p>

            <h1 class="text-5xl lg:text-6xl font-bold mb-5 leading-tight">
              Hola, soy<br/>
              <span class="text-white">Oscar Román</span>
            </h1>

            <p class="text-2xl lg:text-3xl mb-6 font-medium">
              Analista Funcional y de Soluciones Digitales
            </p>

            <p class="text-lg text-gray-300 mb-8 max-w-xl">
              Conecto necesidades de usuarios y organizaciones con procesos, requisitos,
              datos y tecnología para construir soluciones digitales claras, medibles y sostenibles.
            </p>

            <p class="text-base text-gray-400 mb-10">
              Análisis funcional · BPMN · SQL · APIs · Automatización · Plataformas LMS · IA aplicada
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start md:items-start gap-6">

              <!-- Download CV Button -->
              <a
                href="/cv-oscar-roman-2026.pdf"
                class="bg-accent-yellow text-black font-bold py-3 px-6 rounded-2xl no-underline hover:bg-yellow-400 transition inline-block"
                target="_blank"
              >
                Descargar CV
              </a>

              <!-- Social Icons -->
              <div class="flex gap-5">
                <a href="https://github.com/okipe/" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 16 16" class="w-8 h-8 fill-white hover:fill-accent-yellow transition">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
                  </svg>
                </a>

                <a href="https://www.linkedin.com/in/oscarroman1/" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" class="w-8 h-8 fill-white hover:fill-accent-yellow transition">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                  </svg>
                </a>

                <a href="https://www.behance.net/oki_pe" target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" class="w-8 h-8 fill-white hover:fill-accent-yellow transition">
                    <path d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14h-8.027c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988h-6.466v-14.967h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 8.061-3.207 8.061zm-3.466-8.988h3.584c2.508 0 2.906-3-.312-3h-3.272v3zm3.391 3h-3.391v3.016h3.341c3.055 0 2.868-3.016.05-3.016z"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Right Column - Imagen hero (OCULTA en móvil) -->
          <div class="hero__right hidden md:flex justify-center items-center">
            <img
              src={heroImage.src}
              alt="Oscar Román trabajando con procesos, datos, sistemas y soluciones digitales"
              class="w-full h-auto rounded-2xl"
              width="920"
              height="585"
              loading="eager"
            />
          </div>
        </div>
      </section>

      <!-- Value Proposition -->
      <section class="my-20">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="bg-card-dark rounded-2xl p-7">
            <div class="text-accent-yellow text-3xl mb-4">
              <i class="bi bi-diagram-3"></i>
            </div>
            <h2 class="text-xl font-bold mb-3">Análisis funcional</h2>
            <p class="text-gray-300 leading-relaxed">
              Comprensión de necesidades, stakeholders, procesos y requisitos para traducir problemas
              de negocio en soluciones digitales verificables.
            </p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <div class="text-accent-yellow text-3xl mb-4">
              <i class="bi bi-bar-chart"></i>
            </div>
            <h2 class="text-xl font-bold mb-3">Datos y automatización</h2>
            <p class="text-gray-300 leading-relaxed">
              Uso de SQL, Python y hojas de cálculo para organizar, validar, analizar y automatizar
              información vinculada con procesos reales.
            </p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <div class="text-accent-yellow text-3xl mb-4">
              <i class="bi bi-layers"></i>
            </div>
            <h2 class="text-xl font-bold mb-3">Plataformas y tecnología</h2>
            <p class="text-gray-300 leading-relaxed">
              Experiencia con LMS, web, soporte tecnológico y sistemas, complementada con Linux,
              APIs, desarrollo e inteligencia artificial aplicada.
            </p>
          </div>
        </div>
      </section>

      <!-- Projects Section -->
      <section id="proyectos" class="my-24">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Proyectos y casos destacados</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">
            Experiencias donde combino análisis, implementación, soporte, datos y tecnología para resolver necesidades concretas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

          <!-- Project 1: Moodle -->
          <ProjectCard
            title="Implementación y operación de plataforma Moodle"
            description="Gestión funcional y técnica de una plataforma LMS para cursos virtuales: usuarios, contenidos, soporte, incidencias y análisis de datos de participación."
            tags={['Moodle', 'MySQL', 'Soporte funcional', 'Datos']}
            image={moodleImage}
          />

          <!-- Project 2: Human Perú -->
          <ProjectCard
            title="Gestión web y servicios digitales - Human Perú"
            description="Administración de sitio WordPress y servicios digitales de la organización, incluyendo contenidos, soporte web, cPanel y correo electrónico."
            tags={['WordPress', 'CPanel', 'Soporte', 'Servicios web']}
            image={wordpressImage}
          />

          <!-- Project 3: Streaming -->
          <ProjectCard
            title="Operación digital de webinars"
            description="Coordinación técnica de más de 250 webinars: requerimientos, cronogramas, capacitación previa, plataformas de streaming y soporte a expositores y usuarios."
            tags={['Procesos', 'Stakeholders', 'Zoom', 'OBS']}
            image={streamingImage}
          />

          <!-- Project 4: Efficace -->
          <ProjectCard
            title="Efficace Laboral - Sitio corporativo"
            description="Desarrollo frontend de sitio web corporativo con HTML5, SCSS y Bootstrap, aplicando diseño responsivo y organización de contenidos."
            tags={['HTML', 'SCSS', 'Bootstrap', 'JavaScript']}
            link="https://github.com/okipe/website-efficace-4-bootstrap"
            image={efficaceImage}
          />

          <!-- Project 5: Impact -->
          <ProjectCard
            title="ISC 2024 - Web de concurso de startups"
            description="Diseño y desarrollo de sitio web para una competencia de emprendimientos con Webflow, combinando arquitectura de información, UX/UI y publicación web."
            tags={['Webflow', 'UX/UI', 'No-code']}
            image={impactImage}
            link="https://www.behance.net/gallery/206918725/WebFlow-Website-for-Impact-Startup-Competition"
          />

          <!-- Project 6: Cloud Lab -->
          <ProjectCard
            title="Laboratorio personal de sistemas"
            description="Entorno de aprendizaje para administración Linux, virtualización y redes con VirtualBox y KVM, orientado a fortalecer fundamentos de infraestructura y troubleshooting."
            tags={['Linux', 'VirtualBox', 'KVM', 'Networking']}
            image={cloudLabImage}
          />

        </div>
      </section>

      <!-- How I Work -->
      <section class="my-24">
        <div class="text-center mb-14">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Cómo abordo una solución</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">
            Un enfoque que conecta comprensión del problema, modelado, validación y mejora continua.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">01</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Entender</h3>
            <p class="text-gray-300">Necesidades, usuarios, stakeholders, contexto y objetivos del proceso.</p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">02</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Modelar</h3>
            <p class="text-gray-300">Procesos AS-IS / TO-BE, flujos, reglas de negocio, datos y dependencias.</p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">03</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Especificar</h3>
            <p class="text-gray-300">Requisitos, historias de usuario, criterios de aceptación y documentación funcional.</p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">04</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Validar</h3>
            <p class="text-gray-300">Casos de prueba, revisión de datos, APIs, incidencias y criterios de calidad.</p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">05</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Implementar</h3>
            <p class="text-gray-300">Coordinación con equipos, configuración de plataformas, soporte y adopción.</p>
          </div>

          <div class="bg-card-dark rounded-2xl p-7">
            <span class="text-accent-yellow text-sm font-bold">06</span>
            <h3 class="text-xl font-bold mt-2 mb-3">Medir y mejorar</h3>
            <p class="text-gray-300">Indicadores, retroalimentación, automatización y mejora continua del proceso.</p>
          </div>
        </div>
      </section>

      <!-- About Me Section -->
      <section id="sobre-mi" class="my-24">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Sobre mí</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">
            Comunicación, gestión y sistemas aplicados a problemas digitales reales.
          </p>
        </div>

        <div class="max-w-4xl mx-auto mb-16">
          <div class="bg-card-dark rounded-2xl p-8 md:p-12">
            <div class="prose prose-lg prose-invert max-w-none">
              <p class="text-gray-300 leading-relaxed mb-6 text-lg">
                Soy <strong class="text-white">estudiante del último ciclo de Ingeniería de Sistemas Computacionales</strong>
                y comunicador social con experiencia profesional en innovación, educación, plataformas digitales,
                capacitación, gestión web y coordinación con stakeholders.
              </p>

              <p class="text-gray-300 leading-relaxed mb-6 text-lg">
                Mi transición hacia TI se apoya en una experiencia previa donde ya trabajé con
                <strong class="text-accent-yellow">usuarios, procesos, documentación, soporte, datos y soluciones digitales</strong>.
                Actualmente estoy orientando ese recorrido hacia <strong class="text-white">Análisis Funcional y soluciones digitales</strong>,
                reforzando BPMN, requisitos, SQL, APIs, pruebas y automatización.
              </p>

              <p class="text-gray-300 leading-relaxed text-lg">
                Mantengo además una base técnica en desarrollo web, Linux, virtualización y plataformas,
                junto con interés en <strong class="text-accent-yellow">inteligencia artificial aplicada</strong>.
                Busco aportar como puente entre necesidades de negocio, experiencia de usuario y equipos tecnológicos.
              </p>
            </div>
          </div>
        </div>

        <!-- Skills Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

          <SkillCard
            title="Análisis Funcional"
            icon="diagram-3"
            skills={[
              'Requisitos funcionales',
              'BPMN / procesos',
              'Historias de usuario',
              'Criterios de aceptación',
              'Stakeholders'
            ]}
          />

          <SkillCard
            title="Datos & Automatización"
            icon="bar-chart"
            skills={[
              'SQL / MySQL',
              'Python',
              'Excel / Google Sheets',
              'Power BI',
              'Calidad de información'
            ]}
          />

          <SkillCard
            title="Plataformas & QA"
            icon="layers"
            skills={[
              'Moodle / Thinkific',
              'APIs REST / Postman',
              'Testing funcional',
              'WordPress / CPanel',
              'Git / GitHub'
            ]}
          />

          <SkillCard
            title="Sistemas & IA aplicada"
            icon="cpu"
            skills={[
              'Linux / Bash',
              'Docker',
              'VirtualBox / KVM',
              'Rasa / IA aplicada',
              'Redes y seguridad básica'
            ]}
          />

        </div>
      </section>

      <!-- Technical Lab -->
      <section id="laboratorio" class="my-24">
        <div class="text-center mb-14">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Laboratorio técnico</h2>
          <p class="text-gray-300 text-lg max-w-3xl mx-auto">
            Espacio de experimentación para mantener profundidad técnica sin perder el foco en análisis y soluciones.
          </p>
        </div>

        <div class="bg-card-dark rounded-2xl p-8 md:p-10">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <h3 class="text-xl font-bold mb-3">Linux & sistemas</h3>
              <p class="text-gray-300">
                Administración, virtualización, redes, troubleshooting y automatización con Bash.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-3">Integración & despliegue</h3>
              <p class="text-gray-300">
                APIs, Git, Docker y prácticas de despliegue para comprender mejor el ciclo de entrega de software.
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold mb-3">IA aplicada</h3>
              <p class="text-gray-300">
                Chatbots, Rasa, automatización y experimentación orientada a resolver necesidades de soporte y procesos.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section id="contacto" class="my-24">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold mb-4">Contacto</h2>
          <p class="text-gray-300 text-lg max-w-2xl mx-auto">
            ¿Buscas colaborar en análisis funcional, automatización, plataformas educativas o proyectos digitales?
            Conversemos.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">

          <a
            href="mailto:oscarroman.pe@gmail.com"
            class="contact-card bg-card-dark rounded-2xl p-8 text-center transition-all hover:scale-105 hover:shadow-2xl no-underline group"
          >
            <div class="text-accent-yellow text-5xl mb-4 group-hover:scale-110 transition">
              <i class="bi bi-envelope"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">Email</h3>
            <p class="text-gray-300">oscarroman.pe@gmail.com</p>
          </a>

          <a
            href="https://www.linkedin.com/in/oscarroman1/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-card bg-card-dark rounded-2xl p-8 text-center transition-all hover:scale-105 hover:shadow-2xl no-underline group"
          >
            <div class="text-accent-yellow text-5xl mb-4 group-hover:scale-110 transition">
              <i class="bi bi-linkedin"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">LinkedIn</h3>
            <p class="text-gray-300">@oscarroman1</p>
          </a>

          <a
            href="https://github.com/okipe/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-card bg-card-dark rounded-2xl p-8 text-center transition-all hover:scale-105 hover:shadow-2xl no-underline group"
          >
            <div class="text-accent-yellow text-5xl mb-4 group-hover:scale-110 transition">
              <i class="bi bi-github"></i>
            </div>
            <h3 class="text-xl font-bold mb-2 text-white">GitHub</h3>
            <p class="text-gray-300">@okipe</p>
          </a>

        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>